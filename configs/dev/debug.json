{
  "name": "debug",
  "profile": "dev",
  "description": "Devcontainer local debugging — host MySQL via host.docker.internal, Kiwoom mock API",

  "secrets": {
    "mysql": ".secrets/dev/debug/mysql.json",
    "broker": ".secrets/dev/debug/broker.json"
  },

  "environment": {
    "TZ": "Asia/Seoul",
    "PYTHONPATH": "/app",
    "INVESTBOT_CONFIG": "configs/dev/debug.json",
    "INVESTBOT_PROFILE": "dev",
    "INVESTBOT_SECRETS_DIR": ".secrets/dev/debug",
    "INVESTBOT_MYSQL_CONFIG": ".secrets/dev/debug/mysql.json",
    "INVESTBOT_BROKER_CONFIG": ".secrets/dev/debug/broker.json",
    "KIWOOM_TIMEOUT": "15"
  },

  "environment_from_secrets": {
    "broker": {
      "KIWOOM_BASE_URL": "base_url",
      "KIWOOM_APP_KEY": "app_key",
      "KIWOOM_SECRET_KEY": "app_secret",
      "KIWOOM_ACCOUNT_NO": "account_no"
    }
  },

  "run": {
    "timezone": "Asia/Seoul",
    "log_level": "DEBUG"
  },

